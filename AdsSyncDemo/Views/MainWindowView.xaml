<Window x:Class="AdsSyncClientDemo.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdsSyncClientDemo.Views"
        xmlns:vm="clr-namespace:AdsSyncClientDemo.ViewModels"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="Ads Sync Client Demo" Height="450" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="15*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="60*" />
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="60*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="100*" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="100*" />
            <ColumnDefinition Width="9*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TextBlockAds"
                   Grid.Row="3"
                   Grid.Column="1"
                   Text="ADS:"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
        <TextBox x:Name="TextBoxAds"
                 Grid.Row="3"
                 Grid.Column="3"
                 Text="{Binding NetId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 IsEnabled="{Binding SyncClient.IsConnected, Converter={StaticResource IsFalseConverter}}"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center" />
        <Button x:Name="ButtonActivate"
                Grid.Row="7"
                Grid.Column="1"
                Content="Activate"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsEnabled="{Binding SyncClient.IsActive, Converter={StaticResource IsFalseConverter}}"
                Command="{Binding StartSyncCommand}"/>
        <Button x:Name="ButtonDeactivate"
                Grid.Row="7"
                Grid.Column="3"
                Content="Deactivate"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                 IsEnabled="{Binding SyncClient.IsActive}"
                Command="{Binding StopSyncCommand}" />
        <TextBlock x:Name="TextBlockRead"
                   Grid.Row="1"
                   Grid.Column="7"
                   Text="Read Data:"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <Border Grid.Row="3"
                Grid.RowSpan="11"
                BorderBrush="DarkGray"
                BorderThickness="1"
                Grid.Column="7">
            <ItemsControl ItemsSource="{Binding DataFromClientRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Name}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock x:Name="TextBlockWrite"
                   Grid.Row="1"
                   Grid.Column="5"
                   Text="Data to write:"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <Border Grid.Row="3"
                Grid.RowSpan="11"
                BorderBrush="DarkGray"
                BorderThickness="1"
                Grid.Column="5">
            <ItemsControl ItemsSource="{Binding DataToClientRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Name}" />

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock x:Name="TextBlockSoftwareState"
            Grid.Row="13"
            Grid.Column="1"
            Text="Software state:"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"/>
        <TextBlock x:Name="TextBlockHardwareState"
            Grid.Row="11"
            Grid.Column="1"
            Text="Hardware state:"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"/>
        <TextBox x:Name="TextBoxSoftwareState"
                 Grid.Row="13"
                 Grid.Column="3"
                 IsReadOnly="True"
                 Text="{Binding SyncClient.StateSoftware, FallbackValue='No ads client generated yet'}"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center" />
        <TextBox x:Name="TextBoxHardwareState"
                 Grid.Row="11"
                 Grid.Column="3"
                 IsReadOnly="True"
                 Text="{Binding SyncClient.StateHardware, FallbackValue='No ads client generated yet'}"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center" />
        <TextBlock x:Name="TextBlockHardwareState_Copy"
            Grid.Row="9"
            Grid.Column="1"
            Text="Is connected:"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"/>
        <TextBox x:Name="TextBoxIsConnected"
            Grid.Row="9"
            Grid.Column="3"
            IsReadOnly="True"
            Text="{Binding SyncClient.IsConnected, FallbackValue='No ads client generated yet'}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center" />
        <TextBlock x:Name="TextBlockPort"
            Grid.Row="5"
            Grid.Column="1"
            Text="Port:"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"/>
        <TextBox x:Name="TextBoxPort"
                 Grid.Row="5"
                 Grid.Column="3"
                 Text="{Binding Port, Mode=TwoWay}"
                 IsEnabled="{Binding SyncClient.IsConnected, Converter={StaticResource IsFalseConverter}}"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center" />
    </Grid>

</Window>
